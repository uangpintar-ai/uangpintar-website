model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  firstName             String
  lastName              String
  phone                 String                @unique
  password              String?
  balance               Float                 @default(0)
  aiSessionCount        Int                   @default(0)
  maxAISession          Int
  aiSessionResetAt      DateTime              @default(now()) @map("ai_session_reset_at")
  role                  Role                  @default(USER)
  status                UserStatus            @default(UNVERIFIED)
  packageStart          DateTime
  packageRnd            DateTime
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  transactions          Transaction[]
  wallets               Wallet[]
  transactionCategories TransactionCategory[]
  aiChatSessions        AIChatSession[]
  aiAnalysisSessions    AIAnalysisSession[]
  payments              Payment[]
  budgets               Budget[]

  @@map("users")
}

enum Role {
  USER
}

enum UserStatus {
  UNVERIFIED
  GRATIS
  PEMULA_BULANAN
  PEMULA_TAHUNAN
  PAKET_JAGO
  INACTIVE
  SUSPENDED
}
